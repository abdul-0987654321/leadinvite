# ---------------------------------------------------------------
# Copy to .env for local use. On Render, set these in the dashboard
# under Environment. Never commit the real .env.
# ---------------------------------------------------------------

PORT=3000

# Shared secret so random traffic can't inject fake leads.
# Invent any long random string, then append ?secret=THIS to the
# webhook URL you give the agency.
WEBHOOK_SECRET=change-me-to-something-long-and-random

# --- Google Sheets ---------------------------------------------
# The ID from the sheet URL:
# docs.google.com/spreadsheets/d/<THIS PART>/edit
SHEET_ID=
SHEET_TAB=Leads

# The whole service-account JSON on ONE line, or base64 of it.
# Remember to share the sheet with the service account's
# client_email as Editor, or every write fails with 403.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- WhatsApp Cloud API ----------------------------------------
# From Meta -> WhatsApp -> API Setup
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_TEMPLATE_NAME=invito_canale
WA_TEMPLATE_LANG=it
WA_GRAPH_VERSION=v21.0

# Any string you choose; used once when subscribing the webhook in Meta.
WA_VERIFY_TOKEN=
